{
  "expo": {
    "name": "couch-party",
    "slug": "couch-party",
    "scheme": "couch-party",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#111017",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.couchpartyteam.couchparty"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#14171E"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.couchpartyteam.couchparty"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon-light.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#F5F4FA",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#111017"
          }
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "b27aaf8b-6230-44f0-9aff-6baaad19d682"
      }
    }
  }
}
